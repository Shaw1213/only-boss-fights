# ---------------------------------------------------------------
# Unity-generated folders (rebuilt by the Editor; never commit)
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
# Burst output written at the project root by WebGL builds (root only; Assets/Data is tracked)
/Data/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Meta files are only ignored together with an ignored asset
!/[Aa]ssets/**/*.meta

# Autogenerated JetBrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables build output
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------
# IDE and solution files (regenerated by Unity)
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.tmp
*.pidb.meta
*.pdb.meta
*.mdb.meta

# ---------------------------------------------------------------
# Build outputs and crash reports
# ---------------------------------------------------------------
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
sysinfo.txt
crashlytics-build.properties

# ---------------------------------------------------------------
# Secrets — never commit (DREAMLAYER_API_KEY lives in the environment)
# ---------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.pfx
*.p12

# ---------------------------------------------------------------
# OS and personal tool settings
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.claude/settings.local.json

# Python bytecode (Tools/ imports defringe.py)
__pycache__/
